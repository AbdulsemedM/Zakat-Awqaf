<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. flutter_secure_storage's values are encrypted with
     a Keystore key that is not backed up, so a restored copy can't be
     decrypted on a new device: leave them out of backups. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
