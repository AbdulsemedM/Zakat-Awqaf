<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Backups are off (allowBackup="false"); in case
     that changes, keep app data out of them: SharedPreferences hold payment
     records, and flutter_secure_storage's values are encrypted with a
     Keystore key that can't leave the device. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
</full-backup-content>
