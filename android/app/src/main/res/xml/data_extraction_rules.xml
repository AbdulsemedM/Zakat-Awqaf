<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above. allowBackup="false" does not stop device-to-device
     transfer, so app data is excluded here too: SharedPreferences hold
     payment records, and flutter_secure_storage's values are encrypted with
     a Keystore key that can't leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
